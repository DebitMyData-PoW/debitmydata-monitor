   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "timeseries",
   "title": "CPU used",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 - avg by (server) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100",
     "legendFormat": "{{server}}",
     "range": true
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c80815"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",
