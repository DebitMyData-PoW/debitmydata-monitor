   "id": 8,
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 9
   }
  },
  {
   "type": "timeseries",
   "title": "Mining cost and reference price",
   "description": "Log scale. Mining cost: the electricity to mine 1 DMD at the approved figures (config/mining-cost.toml). Reference price: the gateway's, as recorded.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "dmdwatch"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(time, $__interval), avg(mining_cost_usd) AS \"Mining cost\" FROM blocks WHERE $__timeFilter(time) AND mining_cost_usd > 0 GROUP BY 1 ORDER BY 1"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "dmdwatch"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(observed_at, $__interval), avg(usd_per_dmd) AS \"Reference price\" FROM prices WHERE $__timeFilter(observed_at) GROUP BY 1 ORDER BY 1"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "dmdwatch"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth",
      "scaleDistribution": {
       "type": "log",
       "log": 10
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c99a06"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "B"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c80815"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "interval": "10m",
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 9
   }
  },
  {
   "type": "timeseries",
   "title": "Minutes between blocks",
   "description": "The chain aims at 2.5 minutes.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "dmdwatch"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(time, $__interval), ($__interval_ms / 60000.0) / count(*) AS \"Minutes per block\" FROM blocks WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "dmdwatch"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "#1fa463",
        "value": 2.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "interval": "1h",
   "id": 10,
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 9
   }
  },
  {
   "type": "piechart",
   "title": "Who found the blocks",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "dmdwatch"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT CASE WHEN pool THEN 'DebitMyData pool' ELSE coalesce(nullif(split_part(coinbase_tag, ' | ', -1), ''), (SELECT k FROM jsonb_object_keys(payouts) AS k LIMIT 1), 'unknown') END AS \"Miner\", count(*) AS \"Blocks\" FROM blocks WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 2 DESC"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "dmdwatch"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "values": true,
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value",
      "percent"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "id": 11,
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 8,
    "h": 9
   }
  },
  {
   "type": "timeseries",
   "title": "Share of blocks found by the pool",
   "description": "Below 100%: someone mines outside the pool.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "dmdwatch"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(time, $__interval), avg(CASE WHEN pool THEN 1.0 ELSE 0.0 END) AS \"Pool\" FROM blocks WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "dmdwatch"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c80815"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "interval": "1h",
   "id": 12,
   "gridPos": {
    "x": 8,
    "y": 22,
    "w": 8,
    "h": 9
   }
  },
  {
   "type": "table",
   "title": "Reorganizations seen",
   "description": "Blocks that left the chain while the chain watch was watching.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "dmdwatch"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT detected_at AS \"Seen\", fork_height AS \"After block\", depth AS \"Blocks replaced\" FROM reorgs ORDER BY detected_at DESC LIMIT 50"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "dmdwatch"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "id": 13,
   "gridPos": {
    "x": 16,
    "y": 22,
    "w": 8,
    "h": 9
   }
  },
  {
   "type": "table",
   "title": "Latest blocks",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "dmdwatch"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT height AS \"Block\", time AS \"Time\", CASE WHEN pool THEN 'DebitMyData pool' ELSE coalesce(nullif(split_part(coinbase_tag, ' | ', -1), ''), (SELECT k FROM jsonb_object_keys(payouts) AS k LIMIT 1), 'unknown') END AS \"Miner\", round(difficulty::numeric, 2) AS \"Difficulty\", tx_count AS \"Transactions\", reward_data / 100000000.0 AS \"Reward (DMD)\", hash AS \"Hash\" FROM blocks ORDER BY height DESC LIMIT 50"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "dmdwatch"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "id": 14,
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 24,
    "h": 10
   }
  }
 ]
}
