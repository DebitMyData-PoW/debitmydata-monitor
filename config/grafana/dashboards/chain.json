  {
   "type": "timeseries",
   "title": "Hashrate",
   "description": "The work of the blocks found in each interval, divided by its length.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "dmdwatch"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(time, $__interval), sum(difficulty) * 4294967296 / ($__interval_ms / 1000.0) AS \"Hashrate\" FROM blocks WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "dmdwatch"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Hs",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c80815"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "interval": "1h",
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   }
  },
  {
   "type": "timeseries",
   "title": "Difficulty",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "dmdwatch"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(time, $__interval), avg(difficulty) AS \"Difficulty\" FROM blocks WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "dmdwatch"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c99a06"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
