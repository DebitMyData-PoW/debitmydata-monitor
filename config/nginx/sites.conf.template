# The monitoring server's websites, behind Cloudflare (proxied), with Cloudflare's origin
# certificate. Written by install.sh from config/nginx/sites.conf.template.
#   @STATS_HOST@     DMD Stats, the public page (static files and the chain watch's /api/)
#   @GRAFANA_HOST@   Grafana, for the team (its own sign-in)

map $http_upgrade $dmd_connection_upgrade {
    default upgrade;
    "" close;
}

# Any other name, or the server's IP: nothing.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 444;
}
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    server_name @STATS_HOST@ @GRAFANA_HOST@;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @STATS_HOST@;
    ssl_certificate @CERT@;
    ssl_certificate_key @KEY@;
    root /var/www/debitmydata-stats;
    index index.html;
    charset utf-8;
    gzip on;
    gzip_types text/css application/javascript application/json text/csv image/svg+xml application/manifest+json;
    include snippets/debitmydata-headers.conf;
    include snippets/debitmydata-stats-csp.conf;

    # The figures: written every minute by the chain watch. Public: any site may read them.
    location /api/ {
        alias /var/lib/debitmydata-monitor/public/api/;
        types { application/json json; text/csv csv; }
        add_header Cache-Control "public, max-age=60" always;
        add_header Access-Control-Allow-Origin "*" always;
        include snippets/debitmydata-headers.conf;
        include snippets/debitmydata-stats-csp.conf;
    }
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        include snippets/debitmydata-headers.conf;
        include snippets/debitmydata-stats-csp.conf;
    }
    location = /manifest.json {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "public, max-age=3600" always;
        include snippets/debitmydata-headers.conf;
        include snippets/debitmydata-stats-csp.conf;
    }
    # For the Android app from Google Play, once it exists (see the README)
    location = /.well-known/assetlinks.json {
        types { }
        default_type application/json;
    }
    location ~* \.(?:png|ico|woff2|js|css)$ {
        add_header Cache-Control "public, max-age=604800" always;
        include snippets/debitmydata-headers.conf;
        include snippets/debitmydata-stats-csp.conf;
    }
    location / {
        add_header Cache-Control "no-cache" always;
        include snippets/debitmydata-headers.conf;
        include snippets/debitmydata-stats-csp.conf;
        try_files $uri $uri/ =404;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @GRAFANA_HOST@;
    ssl_certificate @CERT@;
    ssl_certificate_key @KEY@;
    include snippets/debitmydata-headers.conf;
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    # Grafana Live (dashboards that update by themselves)
    location /api/live/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $dmd_connection_upgrade;
        proxy_set_header Host $host;
    }
}
